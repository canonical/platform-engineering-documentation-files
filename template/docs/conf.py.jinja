# Documentation website URL
{% if rtd_slug %}
ogp_site_url = f"https://canonical.com/{{ rtd_slug }}/{version}/"
{% else %}
ogp_site_url = os.environ.get("READTHEDOCS_CANONICAL_URL", "/")
{% endif %}

# Preview name of the documentation website
