{
  "_comment": "Maps each upstream conf.py config key to its location in template/docs/conf.py.jinja. Consumed by scripts/analyze_conf_diff.py. 'line_anchor' is a unique substring used to locate the key in the template. 'type' drives how a detected change is applied. 'copier_key' links a value to a copier.yml variable when type is 'copier_variable'.",
  "template_path": "template/docs/conf.py.jinja",
  "sections": {
    "project": {
      "jinja_section": "Project information",
      "line_anchor": "project = \"{{ project }}\"",
      "type": "copier_variable",
      "copier_key": "project"
    },
    "author": {
      "jinja_section": "Project information",
      "line_anchor": "author = \"{{ author }}\"",
      "type": "copier_variable",
      "copier_key": "author"
    },
    "copyright": {
      "jinja_section": "Project information",
      "line_anchor": "copyright = f\"{datetime.date.today().year}\"",
      "type": "hardcoded"
    },
    "version": {
      "jinja_section": "Project information",
      "line_anchor": "version = f\"{os.environ.get('READTHEDOCS_VERSION', 'local')}\"",
      "type": "hardcoded"
    },
    "html_title": {
      "jinja_section": "Project information",
      "line_anchor": "html_title = project + \" documentation\"",
      "type": "hardcoded"
    },
    "ogp_site_url": {
      "jinja_section": "Project information",
      "line_anchor": "ogp_site_url =",
      "type": "jinja_conditional"
    },
    "ogp_site_name": {
      "jinja_section": "Project information",
      "line_anchor": "ogp_site_name = project",
      "type": "hardcoded"
    },
    "ogp_image": {
      "jinja_section": "Project information",
      "line_anchor": "ogp_image = \"{{ ogp_image }}\"",
      "type": "copier_variable",
      "copier_key": "ogp_image"
    },
    "html_favicon": {
      "jinja_section": "Project information",
      "line_anchor": "html_favicon = \"{{ html_favicon }}\"",
      "type": "jinja_conditional",
      "copier_key": "html_favicon"
    },
    "html_context": {
      "jinja_section": "Project information",
      "line_anchor": "html_context = {",
      "type": "dict",
      "copier_mapping": {
        "product_page": "product_page",
        "product_tag": "product_tag",
        "discourse": "discourse",
        "mattermost": "mattermost",
        "matrix": "matrix",
        "github_url": "github_url",
        "repo_default_branch": "repo_default_branch",
        "repo_folder": "repo_folder",
        "display_contributors": "display_contributors"
      }
    },
    "html_theme_options": {
