    "slug": {
      "jinja_section": "Project information",
      "line_anchor": "slug = \"{{ rtd_slug }}\"",
      "type": "jinja_conditional",
      "copier_key": "rtd_slug"
    },
    "html_baseurl": {
      "jinja_section": "Sitemap configuration",
      "line_anchor": "html_baseurl =",
      "type": "jinja_conditional"
    },
    "sitemap_url_scheme": {
      "jinja_section": "Sitemap configuration",
      "line_anchor": "sitemap_url_scheme = \"{link}\"",
      "type": "hardcoded"
    },
    "sitemap_filename": {
      "jinja_section": "Sitemap configuration",
      "line_anchor": "sitemap_filename = \"doc-sitemap.xml\"",
      "type": "hardcoded"
    },
    "sitemap_show_lastmod": {
      "jinja_section": "Sitemap configuration",
      "line_anchor": "sitemap_show_lastmod = True",
      "type": "hardcoded"
    },
    "sitemap_excludes": {
      "jinja_section": "Sitemap configuration",
      "line_anchor": "sitemap_excludes = [",
      "type": "list"
    },
