      "jinja_section": "Template and asset locations",
      "line_anchor": "html_static_path = [\"_static\"]",
      "type": "list"
    },
    "templates_path": {
      "jinja_section": "Template and asset locations",
      "line_anchor": "templates_path = [\"_templates\"]",
      "type": "list"
    },
    "rediraffe_redirects": {
      "jinja_section": "Redirects",
      "line_anchor": "rediraffe_redirects = \"redirects.txt\"",
      "type": "hardcoded"
    },
    "rediraffe_dir_only": {
      "jinja_section": "Redirects",
      "line_anchor": "rediraffe_dir_only = True",
      "type": "hardcoded"
    },
    "llms_txt_description": {
      "jinja_section": "sphinx-llm configuration",
      "line_anchor": "llms_txt_description = textwrap.dedent(",
      "type": "copier_variable",
      "copier_key": "llms_txt_description"
    },
    "markdown_http_base": {
      "jinja_section": "sphinx-llm configuration",
      "line_anchor": "markdown_http_base = html_baseurl",
      "type": "hardcoded"
    },
    "linkcheck_ignore": {
      "jinja_section": "Link checker exceptions",
      "line_anchor": "linkcheck_ignore = [",
      "type": "list"
    },
    "linkcheck_anchors_ignore_for_url": {
      "jinja_section": "Link checker exceptions",
      "line_anchor": "linkcheck_anchors_ignore_for_url = [",
      "type": "list"
    },
    "linkcheck_timeout": {
      "jinja_section": "Link checker exceptions",
      "line_anchor": "linkcheck_timeout = {{ linkcheck_timeout }}",
      "type": "copier_variable",
      "copier_key": "linkcheck_timeout"
    },
    "linkcheck_retries": {
      "jinja_section": "Link checker exceptions",
      "line_anchor": "linkcheck_retries = 3",
      "type": "hardcoded"
    },
    "extensions": {
      "jinja_section": "Configuration extras",
      "line_anchor": "extensions = [",
      "type": "list"
    },
    "exclude_patterns": {
      "jinja_section": "Configuration extras",
      "line_anchor": "exclude_patterns = [",
      "type": "list"
    },
    "html_css_files": {
      "jinja_section": "Configuration extras",
      "line_anchor": "html_css_files = [",
      "type": "list"
    },
    "html_js_files": {
      "jinja_section": "Configuration extras",
      "line_anchor": "html_js_files = [",
      "type": "list"
    },
    "rst_prolog": {
      "jinja_section": "Configuration extras",
      "line_anchor": "# rst_prolog =",
      "type": "commented_out"
    },
    "intersphinx_mapping": {
      "jinja_section": "Configuration extras",
      "line_anchor": "# intersphinx_mapping = {",
      "type": "commented_out"
    }
  }
